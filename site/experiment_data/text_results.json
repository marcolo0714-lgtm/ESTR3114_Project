{
  "settings": [
    [
      "Tasks",
      "Next-token prediction and three-class sentiment: negative, neutral, positive."
    ],
    [
      "Model",
      "Pretrained GPT-2 Small (12 layers, hidden size 768), with a shared backbone, an untied pretrained token head, and a randomly initialized sentiment head."
    ],
    [
      "Dataset",
      "TweetEval sentiment: 45,615 training, 2,000 validation, and 12,284 test tweets."
    ],
    [
      "Budgets and seeds",
      "1,000 and 6,000 optimizer steps; seeds 42, 43, and 44. Batch size 8; evaluation batch size 16."
    ],
    [
      "Sequence length",
      "Maximum 96 GPT-2 tokens, including EOS: at most 95 text tokens plus one EOS. Longer texts are truncated; padding is excluded from token loss."
    ],
    [
      "Optimizer",
      "AdamW; learning rate 0.00002; weight decay 0.01; gradient norm clipped at 1."
    ],
    [
      "Schedule",
      "10% warmup followed by linear decay to zero at the chosen final step. Fresh initialization from the pretrained model for each run."
    ],
    [
      "Weights",
      "Sentiment weights 0.1, 0.3, 1.0, and 3.0 at 1,000 steps. Only 3.0 at 6,000 steps. Single-task controls ignore the weight."
    ],
    [
      "Evaluation",
      "Validation every 100 steps; test evaluated at the final step. Gradient diagnostics every 25 steps. Training on CUDA in Google Colab."
    ],
    [
      "Exposure",
      "1,000 × 8 = 8,000 training examples (~0.175 epochs). 6,000 × 8 = 48,000 (~1.05 epochs)."
    ],
    [
      "Interactive demonstration",
      "Four saved seed-44 models, each trained for 6,000 steps. The joint and PCGrad models use sentiment weight 3.0."
    ]
  ],
